{
  "name": "cds-operations",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @cds/web build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:migrate": "pnpm --filter @cds/db migrate",
    "db:seed": "pnpm --filter @cds/test-fixtures seed",
    "dev": "pnpm --filter @cds/web dev",
    "worker": "pnpm --filter @cds/worker start",
    "test:e2e": "pnpm --filter @cds/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "tsx": "4.23.15",
    "vitest": "5.0.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/luxon": "3.7.6"
  },
  "type": "module"
}

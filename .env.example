# CDS Operations configuration. Names and explanations only: never commit values.
# Copy to apps/web/.env.local (web) or set in the hosting secret manager.

# development | test | staging | production
APP_ENV=development
APP_BASE_URL=http://localhost:3000
# 32+ random characters. Signs amendment impact-preview tokens. Required in staging/production.
APP_SECRET=

# Runtime connection as the non-owner role cds_app (no BYPASSRLS). Used by web and worker.
DATABASE_URL=postgresql://cds_app:<password>@localhost:5432/cds_dev
# Owner/migration connection. Only for `pnpm db:migrate` and the seed script.
# Never set this on the deployed web or worker services.
DATABASE_MIGRATION_URL=postgresql://postgres:<password>@localhost:5432/cds_dev
# Local tests: admin connection used to create per-test databases; cds_app password shared by tests and dev.
TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/postgres
CDS_APP_PASSWORD=

# Supabase Auth (server-side verification). Required in staging/production.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Only for isolated auth/storage administration code. Not used by domain code today.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_PRIVATE_BUCKET=
# Configure SMTP for auth emails in the Supabase dashboard secret settings, not here.
AUTH_SMTP_CONFIGURATION=

# Development only: sign in as a seeded synthetic staff member. Refused in staging/production.
DEV_AUTH=false

# Integrations. Disabled integrations need no credentials.
RESEND_API_KEY=
# manual | microsoft_graph | other_supported
EMAIL_PROVIDER=manual
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
AI_ENABLED=false
AI_MODEL=
ANTHROPIC_API_KEY=

ERROR_MONITORING_DSN=

# Worker tuning
OUTBOX_POLL_MS=5000
WORKER_DB_POOL=4
